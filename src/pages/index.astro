    <script is:inline>
      (() => {
        const kineticSections = Array.from(
          document.querySelectorAll("[data-kinetic-section]"),
        );

        if (kineticSections.length === 0) {
          return;
        }

        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        const clamp = (value, min, max) =>
          Math.min(Math.max(value, min), max);
        let sectionFrame = 0;

        const updateKineticSections = () => {
          const viewportHeight = window.innerHeight || 1;

          kineticSections.forEach((section, index) => {
            const rect = section.getBoundingClientRect();
            const progress = clamp(
              (viewportHeight - rect.top) /
                Math.max(viewportHeight + rect.height, 1),
              0,
              1,
            );
            const inView =
              rect.top < viewportHeight * 0.86 &&
              rect.bottom > viewportHeight * 0.14;

            section.classList.toggle("is-in-view", inView);

            if (reduceMotion) {
              return;
            }

            const direction = index % 2 === 0 ? -1 : 1;
            const echoX = (progress - 0.5) * 260 * direction;
            const echoY = (progress - 0.5) * -42;
            const echoScale = 1 + Math.abs(progress - 0.5) * 0.22;

            section.style.setProperty(
              "--section-echo-x",
              `${echoX.toFixed(1)}px`,
            );
            section.style.setProperty(
              "--section-echo-y",
              `${echoY.toFixed(1)}px`,
            );
            section.style.setProperty(
              "--section-echo-scale",
              echoScale.toFixed(3),
            );
          });

          sectionFrame = 0;
        };

        const scheduleKineticUpdate = () => {
          if (!sectionFrame) {
            sectionFrame = window.requestAnimationFrame(updateKineticSections);
          }
        };

        const moveSectionPointer = (event) => {
          if (reduceMotion || event.pointerType === "touch") {
            return;
          }

          const target = event.target;

          if (!(target instanceof Element)) {
            return;
          }

          const section = target.closest("[data-kinetic-section]");

          if (!section) {
            return;
          }

          const rect = section.getBoundingClientRect();
          const x = clamp((event.clientX - rect.left) / rect.width - 0.5, -0.5, 0.5);
          const y = clamp((event.clientY - rect.top) / rect.height - 0.5, -0.5, 0.5);
          const pullX = x * 34;
          const pullY = y * 20;

          section.style.setProperty("--section-pull-x", `${pullX.toFixed(1)}px`);
          section.style.setProperty("--section-pull-y", `${pullY.toFixed(1)}px`);
          section.style.setProperty(
            "--section-stretch",
            (1 + Math.abs(x) * 0.16).toFixed(3),
          );
          section.style.setProperty(
            "--section-image-pull-x",
            `${(x * -22).toFixed(1)}px`,
          );
          section.style.setProperty(
            "--section-image-pull-y",
            `${(y * -18).toFixed(1)}px`,
          );
          section.style.setProperty(
            "--section-fragment-a-x",
            `${(22 - x * 18).toFixed(1)}px`,
          );
          section.style.setProperty(
            "--section-fragment-a-y",
            `${(-12 - y * 14).toFixed(1)}px`,
          );
          section.style.setProperty(
            "--section-fragment-b-x",
            `${(-18 + x * 20).toFixed(1)}px`,
          );
          section.style.setProperty(
            "--section-fragment-b-y",
            `${(16 + y * 16).toFixed(1)}px`,
          );
        };

        kineticSections.forEach((section) => {
          section.addEventListener("pointerleave", () => {
            section.style.setProperty("--section-pull-x", "0px");
            section.style.setProperty("--section-pull-y", "0px");
            section.style.setProperty("--section-stretch", "1");
            section.style.setProperty("--section-image-pull-x", "0px");
            section.style.setProperty("--section-image-pull-y", "0px");
            section.style.setProperty("--section-fragment-a-x", "22px");
            section.style.setProperty("--section-fragment-a-y", "-12px");
            section.style.setProperty("--section-fragment-b-x", "-18px");
            section.style.setProperty("--section-fragment-b-y", "16px");
          });
        });

        updateKineticSections();
        window.addEventListener("scroll", scheduleKineticUpdate, {
          passive: true,
        });
        window.addEventListener("resize", scheduleKineticUpdate, {
          passive: true,
        });
        document.addEventListener("pointermove", moveSectionPointer, {
          passive: true,
        });
      })();
    </script>
